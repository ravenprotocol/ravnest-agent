FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install PyTorch CPU-only
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

# Copy requirements and install Python deps (skip torch since already installed, skip nvidia)
COPY requirements.txt .
RUN pip install --no-cache-dir $(grep -v -E 'torch|nvidia' requirements.txt) \
    && pip install --no-cache-dir fastapi uvicorn "transformers<4.51" accelerate torchinfo

# Copy the project
COPY . .
ENV PYTHONPATH=/app

EXPOSE 8000
